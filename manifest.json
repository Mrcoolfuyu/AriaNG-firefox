{
  "manifest_version": 2,
  "name": "AriaNG",
  "short_name": "AriaNG",
  "version": "1.4.0",
  "default_locale": "zh_CN",
  "description": "__MSG_description__",
  "author": "Mr.cool",
  "homepage_url": "https://github.com/Mrcoolfuyu/",
  "icons": {
    "16": "images/logo16.png",
    "32": "images/logo32.png",
    "48": "images/logo48.png",
    "64": "images/logo64.png",
    "128": "images/logo128.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "images/logo16.png",
      "32": "images/logo32.png",
      "48": "images/logo48.png"
    },
    "default_title": "AriaNG"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "scripts": [
      "js/config.js",
      "js/utils.js",
      "js/aria2.js",
      "js/background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content/clickChecker.js",
        "js/content/exportAll.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "notifications",
    "tabs",
    "cookies",
    "<all_urls>"
  ],
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "__MSG_toggleCapture__"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ariang@mrcoolfuyu.github.io",
      "strict_min_version": "141.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "content_security_policy": "script-src 'self'; object-src 'self'; frame-src 'self'"
}